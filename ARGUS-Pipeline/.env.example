# ARGUS — environment variables for Docker Compose.
#
# Easiest: run `python scripts/init_env.py` (from ARGUS-Pipeline/). It copies this file to .env and replaces every
# CHANGE_ME value and empty secret with a strong random one. Or copy it by hand and fill every value in.
# Never commit the filled-in .env file. Anything still starting with CHANGE_ME is rejected in production mode.

# ── Environment ──────────────────────────────────────────────────────────────
# development (default) allows demo accounts and relaxed checks; any other value is treated as production.
ARGUS_ENV=development
# Creates the demo accounts listed in the README on first start. Must be false in production.
SEED_DEMO_USERS=true

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=argus_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=argus_db

# ── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# ── Elasticsearch ────────────────────────────────────────────────────────────
ELASTIC_PASSWORD=CHANGE_ME

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ── Authentication ───────────────────────────────────────────────────────────
# Signs session tokens (at least 32 characters).
JWT_SECRET=CHANGE_ME
# Encrypts two-step-verification secrets at rest. Losing it locks MFA users out (an admin can reset them).
MFA_ENCRYPTION_KEY=CHANGE_ME
# Roles that must use two-step verification, e.g. admin,supervisor (empty = optional for everyone).
MFA_REQUIRED_ROLES=

# ── Frontend URL allowed by CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── LLM provider (optional — a regex fallback is used when no key is set) ────
# Set LLM_PROVIDER to "groq" or "gemini" and provide the matching key.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# ── Hindi NER fallback (optional, large) ─────────────────────────────────────
# Build with INSTALL_INDIC_NER=true, then set ENABLE_INDIC_NER=true
INSTALL_INDIC_NER=false
ENABLE_INDIC_NER=false

# ── Optional Keycloak / OIDC SSO (leave KEYCLOAK_URL empty to use ARGUS's own sign-in) ──
# When set, only access tokens from this realm are accepted and local sign-in/MFA are disabled.
# The realm needs roles named admin / supervisor / analyst / investigator, and (optionally) a "jurisdiction" claim.
KEYCLOAK_URL=
KEYCLOAK_REALM=argus
KEYCLOAK_AUDIENCE=argus-api
