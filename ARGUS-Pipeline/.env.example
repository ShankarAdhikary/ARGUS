# ARGUS — environment variables for Docker Compose.
# Copy this file to .env and fill in the values before running `docker compose up`.
# Never commit the filled-in .env file.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=argus_db

# ── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ── Elasticsearch ────────────────────────────────────────────────────────────
ELASTIC_PASSWORD=changeme

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=changeme

# ── JWT (generate a long random string for production) ───────────────────────
JWT_SECRET=argus-dev-secret-change-in-production

# ── Frontend URL allowed by CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── LLM provider (optional — regex fallback used when key is absent) ─────────
# Set LLM_PROVIDER to "groq" or "gemini" and provide the matching key.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# --- MFA ---
# Generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MFA_ENCRYPTION_KEY=
MFA_REQUIRED_ROLES=

# Redis (required; use a long random value)
REDIS_PASSWORD=
