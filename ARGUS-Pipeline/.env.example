# ARGUS — environment variables for Docker Compose.
#
# Easiest: run `python scripts/init_env.py` (from ARGUS-Pipeline/). It copies this file to .env and replaces every
# CHANGE_ME value and empty secret with a strong random one. Or copy it by hand and fill every value in.
# Never commit the filled-in .env file. Anything still starting with CHANGE_ME is rejected in production mode.

# ── Environment ──────────────────────────────────────────────────────────────
# development (default) allows demo accounts and relaxed checks; any other value is treated as production.
ARGUS_ENV=development
# Creates the demo accounts listed in the README on first start. Must be false in production.
SEED_DEMO_USERS=true

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=argus_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=argus_db

# ── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# ── Elasticsearch ────────────────────────────────────────────────────────────
ELASTIC_PASSWORD=CHANGE_ME

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ── Authentication ───────────────────────────────────────────────────────────
# Signs session tokens (at least 32 characters).
JWT_SECRET=CHANGE_ME
# Encrypts two-step-verification secrets at rest. Losing it locks MFA users out (an admin can reset them).
MFA_ENCRYPTION_KEY=CHANGE_ME
# Roles that must use two-step verification, e.g. admin,supervisor (empty = optional for everyone).
MFA_REQUIRED_ROLES=

# ── Frontend URL allowed by CORS ─────────────────────────────────────────────
CORS_ORIGINS=https://localhost,http://localhost:5173

# ── LLM provider (optional — a regex fallback is used when no key is set) ────
# Set LLM_PROVIDER to "groq" or "gemini" and provide the matching key.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# ── Hindi NER fallback (optional, large) ─────────────────────────────────────
# On by default; set both to false to skip the ~2-3 GB Indic NER stack
INSTALL_INDIC_NER=true
ENABLE_INDIC_NER=true

# ── Optional Keycloak / OIDC SSO (leave KEYCLOAK_URL empty to use ARGUS's own sign-in) ──
# When set, only access tokens from this realm are accepted and local sign-in/MFA are disabled.
# The realm needs roles named admin / supervisor / analyst / investigator, and (optionally) a "jurisdiction" claim.
KEYCLOAK_URL=
KEYCLOAK_REALM=argus
KEYCLOAK_AUDIENCE=argus-api

# Secret key for hashing victim Aadhaar tokens (required outside development). Generate: openssl rand -hex 32
VICTIM_HASH_PEPPER=

# Offline voice-to-FIR (Whisper small, CPU). Set both to false to skip the ~500 MB model.
INSTALL_VOICE=true
ENABLE_VOICE=true

# ── Secrets vault (HashiCorp Vault) ──────────────────────────────────────────
# Secrets (JWT_SECRET, database passwords, API keys, MFA key, victim-hash pepper) live in Vault and reach the containers
# as files rendered by the vault-agent sidecar. On the FIRST `docker compose up`, any secrets set above are migrated into
# Vault (anything empty is generated) and vault-init prints VAULT_UNSEAL_KEY once: put it here, then delete the migrated
# secrets from this file. After that, .env only needs the unseal key and non-secret settings.
VAULT_ADDR=http://localhost:8200
VAULT_UNSEAL_KEY=

# ── TLS (nginx) ──────────────────────────────────────────────────────────────
# Development generates a self-signed certificate. In production (ARGUS_ENV=production) mount the real tls.crt / tls.key:
# TLS_CERT_DIR=/etc/argus/certs
# HTTPS_PORT=443
# HTTP_PORT=80

# ── Fingerprint identification ───────────────────────────────────────────────
# Comparison engine: SourceAFIS (Java, Apache-2.0) through a JVM bridge; the image includes the JRE and pinned jars.
# Leave empty to disable fingerprint matching (the API then answers 501). Any object with extract()/score() can be plugged
# in as package.module:factory. SourceAFIS scores are specific to this algorithm: they are NOT comparable with scores from
# other AFIS products, and SourceAFIS is built for rolled/plain prints, not validated for latents.
FINGERPRINT_ENGINE=fingerprint:JvmSourceAFISEngine
FINGERPRINT_DPI=500
FINGERPRINT_MATCH_THRESHOLD=40
# Minimum minutiae for a print to be searched. Enrolment and rolled probes use the first; a probe the officer flags as a
# latent (crime-scene partial) uses the lower one. Fewer minutiae means weaker evidence: treat such matches as leads only.
FINGERPRINT_MIN_MINUTIAE=12
FINGERPRINT_MIN_MINUTIAE_LATENT=8
# Threads used to score one probe against the index (SourceAFIS matchers are thread-safe). ~0.5 ms per comparison per thread.
FINGERPRINT_MATCH_THREADS=4
# Written by scripts/evaluate_fingerprint.py from real, licensed data; absent = the SourceAFIS default thresholds above.
# FINGERPRINT_CALIBRATION_FILE=uploads/fingerprint-calibration.json

# ── Voice biometrics (speaker identification on lawfully authorized audio) ───
# OFF, and it must stay off: the endpoints are not registered while this is false. Turn it on only after
# scripts/evaluate_voiceprint.py has been run on real recordings (Hindi, English + a regional language; telephone and direct
# audio) and has written a calibration file: with no calibration the service returns rankings only and production refuses to
# start with it enabled. Every enrolment and match requires a lawful_interception_ref. See docs/voice-biometrics-design.md.
VOICEPRINT_ENABLED=false
INSTALL_VOICEPRINT=true
VOICEPRINT_ENGINE=voiceprint:SpeechBrainEngine
VOICEPRINT_MIN_SPEECH_SECONDS=3
# VOICEPRINT_CALIBRATION_FILE=uploads/voiceprint-calibration.json
