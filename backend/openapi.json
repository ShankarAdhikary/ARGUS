  "components": {
    "schemas": {
      "AddCaseNoteRequest": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "AddCaseNoteRequest"
      },
      "CaseCreateRequest": {
        "properties": {
          "fir_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fir Number"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "title": "Title"
          },
          "jurisdiction_id": {
            "type": "string",
            "format": "uuid",
            "title": "Jurisdiction Id"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "is_sensitive": {
            "type": "boolean",
            "title": "Is Sensitive",
            "default": false
          },
          "sensitivity_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sensitivity Reason"
          }
        },
        "type": "object",
        "required": [
          "title",
          "jurisdiction_id"
        ],
        "title": "CaseCreateRequest"
      },
      "CaseListResponse": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CaseSummary"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "total",
          "items"
        ],
        "title": "CaseListResponse"
      },
      "CaseSummary": {
        "properties": {
          "case_id": {
            "type": "string",
            "format": "uuid",
            "title": "Case Id"
          },
          "fir_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fir Number"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "jurisdiction_id": {
            "type": "string",
            "format": "uuid",
            "title": "Jurisdiction Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "is_sensitive": {
            "type": "boolean",
            "title": "Is Sensitive"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "opened_at": {
            "type": "string",
            "format": "date-time",
            "title": "Opened At"
          }
        },
        "type": "object",
        "required": [
          "case_id",
          "fir_number",
          "title",
          "jurisdiction_id",
          "status",
          "is_sensitive",
          "category",
          "opened_at"
        ],
        "title": "CaseSummary"
      },
      "CaseUpdateRequest": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status",
            "description": "open|under_review|closed"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          }
        },
        "type": "object",
        "title": "CaseUpdateRequest"
      },
      "EntityDetailResponse": {
        "properties": {
          "entity_id": {
            "type": "string",
            "format": "uuid",
            "title": "Entity Id"
          },
          "entity_type": {
            "$ref": "#/components/schemas/EntityType"
          },
          "canonical_name": {
            "type": "string",
            "title": "Canonical Name"
          },
          "confidence_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence Score"
          },
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Aliases"
          },
          "relationships": {
            "items": {
              "$ref": "#/components/schemas/RelationshipSummary"
            },
            "type": "array",
            "title": "Relationships"
          }
        },
        "type": "object",
        "required": [
          "entity_id",
          "entity_type",
          "canonical_name",
          "confidence_score"
        ],
        "title": "EntityDetailResponse"
      },
      "EntityType": {
        "type": "string",
        "enum": [
          "person",
          "organization",
          "location",
          "vehicle",
          "phone",
          "financial_account",
          "event"
        ],
        "title": "EntityType"
      },
      "GraphEdge": {
        "properties": {
          "relationship_id": {
            "type": "string",
            "format": "uuid",
            "title": "Relationship Id"
          },
          "source_entity_id": {
            "type": "string",
            "format": "uuid",
            "title": "Source Entity Id"
          },
          "target_entity_id": {
            "type": "string",
            "format": "uuid",
            "title": "Target Entity Id"
          },
          "relationship_type": {
            "type": "string",
            "title": "Relationship Type"
          },
          "confidence_score": {
            "type": "number",
            "title": "Confidence Score"
          },
          "is_direct": {
            "type": "boolean",
            "title": "Is Direct"
          }
        },
        "type": "object",
        "required": [
          "relationship_id",
          "source_entity_id",
          "target_entity_id",
          "relationship_type",
          "confidence_score",
          "is_direct"
        ],
        "title": "GraphEdge"
      },
      "GraphExpandRequest": {
        "properties": {
          "root_entity_id": {
            "type": "string",
            "format": "uuid",
            "title": "Root Entity Id"
          },
          "max_hops": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Max Hops",
            "default": 2
          },
          "confidence_threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence Threshold",
            "default": 0.5
          },
          "include_indirect": {
            "type": "boolean",
            "title": "Include Indirect",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "root_entity_id"
        ],
        "title": "GraphExpandRequest"
      },
      "GraphExpandResponse": {
        "properties": {
          "root_entity_id": {
            "type": "string",
            "format": "uuid",
            "title": "Root Entity Id"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/GraphNode"
            },
            "type": "array",
            "title": "Nodes"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/GraphEdge"
            },
            "type": "array",
            "title": "Edges"
          }
        },
        "type": "object",
        "required": [
          "root_entity_id",
          "nodes",
          "edges"
        ],
        "title": "GraphExpandResponse"
      },
      "GraphNode": {
        "properties": {
          "entity_id": {
            "type": "string",
            "format": "uuid",
            "title": "Entity Id"
